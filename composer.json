        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Mapi\\Test\\": "test/"
        }
    },
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "2.x-dev"
        }
